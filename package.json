{
  "name": "fledge-billing",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --sort run build",
    "test": "pnpm build:packages && vitest run",
    "dev": "pnpm --filter @fledge/app run dev",
    "start": "pnpm --filter @fledge/app run start",
    "typecheck": "pnpm build:packages && pnpm -r --sort run typecheck",
    "web:dev": "pnpm --filter @fledge/web run dev",
    "web:build": "pnpm --filter @fledge/web run build",
    "build:packages": "pnpm -r --filter '@fledge/app...' --sort run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
